# ---------------------------------------------------------------------------
# ScopeForge - environment configuration
# Copy to .env (repo root) and fill in. The backend reads this file at startup.
# Secrets stay in the backend process; they are never sent to the frontend.
# ---------------------------------------------------------------------------

# --- Weights & Biases (single key powers Inference, Weave and MCP) ----------
# Create at https://wandb.ai/authorize . Required for any real model call.
WANDB_API_KEY=

# W&B team/entity that owns the project used for tracing. Find it at
# https://wandb.ai/home (left sidebar). Required for Weave + MCP evidence.
WANDB_ENTITY=

# W&B project name that Weave traces are written to. Created on first use.
WANDB_PROJECT=scopeforge

# --- LLM provider (OpenAI-compatible) --------------------------------------
# W&B Inference endpoint. Documented at https://docs.wandb.ai/inference
LLM_BASE_URL=https://api.inference.wandb.ai/v1

# Model id used for the support agent, adversary and policy designer.
# Must support tool calling; ScopeForge probes this at runtime via
# Settings -> "Check connection". See https://docs.wandb.ai/inference/models
LLM_MODEL=openai/gpt-oss-120b

# Optional: separate model for the policy designer. Falls back to LLM_MODEL.
LLM_POLICY_MODEL=

# Send the OpenAI-Project header to W&B Inference for usage attribution.
# Left false: this deployment answers 401 invalid_api_key when it is present,
# while the same key works without it. Set to true only if that changes.
LLM_SEND_PROJECT_HEADER=false

# --- W&B MCP server (read-only trace evidence for the policy designer) -----
# Hosted endpoint from https://github.com/wandb/wandb-mcp-server
WANDB_MCP_URL=https://mcp.withwandb.com/mcp

# --- Local services --------------------------------------------------------
# SQLAlchemy URL. Leave empty for the default SQLite file under
# backend/data/runtime/ (gitignored). A relative sqlite path is resolved
# against the repository root, not the working directory.
DATABASE_URL=

BACKEND_PORT=8787
FRONTEND_PORT=5273

# Comma-separated origins allowed to call the API (local development only).
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# --- Optional ---------------------------------------------------------------
# Verified USD rate for the configured model, per 1M tokens. Leave empty and
# ScopeForge reports token usage with "Cost unavailable" instead of guessing.
LLM_COST_PER_MTOK_INPUT=
LLM_COST_PER_MTOK_OUTPUT=
